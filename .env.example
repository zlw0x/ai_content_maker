# Copy to .env locally. Never commit a populated .env.
DATABASE_URL=postgresql://ai_content_maker:change_this_password@localhost:5432/ai_content_maker
POSTGRES_USER=ai_content_maker
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=ai_content_maker
APP_ORIGIN=http://localhost:3000
STORAGE_DIR=./private-media

# Safe defaults. Mock creates generated test assets; no charge to external service.
WAVESPEED_MODE=mock
PAYMENT_MODE=disabled
ALLOW_LIVE_PAYMENTS=false
MOCK_COST_USD=0.005
# Keep false for non-demo environments. Requires mock and disabled payments.
DEMO_CREDIT_ENABLED=true
# Required when enabling live downloads: exact CDN hostnames separated by commas.
OUTPUT_HOST_ALLOWLIST=
# Media outputs remain private in local volume. 30 days from generation.
OUTPUT_RETENTION_DAYS=30
# Strictly operator-only CLI credits on isolated live staging; off by default.
STAGING_MANUAL_CREDIT_ENABLED=false

# Recipe Studio. Enable these together only in a disposable local mock environment.
RECIPE_ORDERS_ENABLED=false
RECIPE_FUNNEL_ENABLED=false
RECIPE_TRIAL_ENABLED=false
RECIPE_TRIAL_DAILY_BUDGET_USD=5
RECIPE_PAYMENT_MODE=disabled
RECIPE_EMAIL_DELIVERY=disabled
# RECIPE_EMAIL_WEBHOOK_URL=https://your-mail-adapter.example/send
# RECIPE_EMAIL_WEBHOOK_SECRET=
# YOOKASSA_TEST_SHOP_ID=
# YOOKASSA_TEST_SECRET_KEY=

# Active only with WAVESPEED_MODE=live:
# WAVESPEED_API_KEY=
# WAVESPEED_WEBHOOK_SECRET=whsec_...
# WAVESPEED_CALLBACK_URL=https://yourdomain.example/api/webhooks/wavespeed

# Active only with PAYMENT_MODE=yookassa and ALLOW_LIVE_PAYMENTS=true:
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=

# Prices / safety caps; explicitly reviewed before enabling live API.
FX_RUB_PER_USD=90
PRICE_MARKUP=2.2
PRICE_FIXED_KOPECKS=500
MAX_PROVIDER_COST_USD=3
MAX_ORDER_KOPECKS=100000
MAX_DAILY_SPEND_KOPECKS=200000
WORKER_CONCURRENCY=2
WORKER_INTERVAL_MS=3000
