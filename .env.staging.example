# This is a TEMPLATE. Never commit the generated .env.staging.
POSTGRES_USER=acm_staging
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
POSTGRES_DB=acm_staging
APP_ORIGIN=http://localhost:3100
STORAGE_DIR=./private-media

# One low-cost real inference with one unique local test account.
WAVESPEED_MODE=live
WAVESPEED_API_KEY=REPLACE_WITH_ROTATED_WAVESPEED_KEY
PAYMENT_MODE=disabled
ALLOW_LIVE_PAYMENTS=false
DEMO_CREDIT_ENABLED=false
STAGING_MANUAL_CREDIT_ENABLED=true

# WaveSpeed own project documents cdn.wavespeed.ai as an example output host.
# If actual output host differs, correct this AFTER the first task without re-submitting.
OUTPUT_HOST_ALLOWLIST=cdn.wavespeed.ai
OUTPUT_RETENTION_DAYS=30

# Conservative ceilings. Internal wallet RUB credits are synthetic and local.
FX_RUB_PER_USD=90
PRICE_MARKUP=2.2
PRICE_FIXED_KOPECKS=500
MAX_PROVIDER_COST_USD=0.01
MAX_ORDER_KOPECKS=1500
MAX_DAILY_SPEND_KOPECKS=1500
WORKER_CONCURRENCY=1
WORKER_INTERVAL_MS=3000
